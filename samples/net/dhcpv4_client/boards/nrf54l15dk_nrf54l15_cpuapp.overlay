/*
 * Device Tree overlay for DM9051 SPI Ethernet Controller on nRF54L15DK
 * 
 * This overlay configures the DM9051 Ethernet controller connected via SPI00.
 * SPI00 is a high-speed SPI interface (up to 32MHz) on the nRF54L15DK.
 * 
 * Pin connections:
 * - SCK:  P2.1  - SPI Clock
 * - MOSI: P2.2  - SPI MOSI (Master Out Slave In)
 * - MISO: P2.4  - SPI MISO (Master In Slave Out)
 * - CS:   P2.3  - Chip Select (configured in cs-gpios)
 * - INT:  P2.5  - Interrupt pin (adjust based on your hardware)
 * 
 * NOTE: Verify these pin assignments match your actual hardware connections!
 * If using different pins, update the CS and INT GPIO assignments below.
 */

&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	
	dm9051: dm9051@0 {
		compatible = "davicom,dm9051";
		reg = <0>;
		spi-max-frequency = <4000000>;  /* 4MHz - reduced for stability */
		int-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
		
		/* Local MAC address */
		local-mac-address = [00 11 22 33 44 55];
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};
