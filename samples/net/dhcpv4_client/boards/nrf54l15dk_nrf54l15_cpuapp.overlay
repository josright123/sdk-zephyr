/*
 * Device Tree overlay for DM9051 SPI Ethernet Controller on nRF54L15DK
 * 
 * This overlay configures the DM9051 Ethernet controller connected via SPI20.
 * SPI20 supports cross-domain pins and can use GPIO1 pins.
 * 
 * Pin connections:
 * - SCK:  P1.3 - SPI Clock
 * - MOSI: P1.1 - SPI MOSI (Master Out Slave In)
 * - MISO: P1.0 - SPI MISO (Master In Slave Out)
 * - CS:   P1.2 - Chip Select (configured in cs-gpios)
 * - INT:  P0.3 - Interrupt pin
 * 
 * SPI Configuration:
 * - Interface: SPI20
 * - Max Frequency: 4MHz (conservative for stability)
 * - Can be increased to 8MHz if stable
 */

&pinctrl {
	spi20_default: spi20_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 0)>;
		};
	};

	spi20_sleep: spi20_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 0)>;
			low-power-enable;
		};
	};
};

&spi20 {
	status = "okay";
	cs-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi20_default>;
	pinctrl-1 = <&spi20_sleep>;
	pinctrl-names = "default", "sleep";
	
	dm9051: dm9051@0 {
		compatible = "davicom,dm9051";
		reg = <0>;
		spi-max-frequency = <4000000>;  /* 4MHz - reduced for stability */
		int-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		
		/* Local MAC address */
		local-mac-address = [00 11 22 33 44 55];
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};
