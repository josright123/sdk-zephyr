/*
 * DM9051 overlay (POLLING mode) for nRF54L15DK CPUAPP
 *
 * - No int-gpios -> eth_dm9051.c uses polling mode (cint(dev)==false)
 * - No reset-gpios -> eth_dm9051.c skips HW reset (crst(dev)==false)
 */

&rram_controller {
	/delete-node/ cpuflpr_sram;
	/delete-node/ cpuflpr_rram;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000 0x20040000>;
};

&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

/* Keep GPIO ports enabled; enable their required GPIOTE instances */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote30 {
	status = "okay";
};

&gpiote20 {
	status = "okay";
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 0)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 0)>;
			low-power-enable;
		};
	};
};

&spi21 {
	status = "okay";
	clocks = <&hfpll>;
	cs-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>; /* CS on P1.2 */
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";

	dm9051: dm9051@0 {
		compatible = "davicom,dm9051";
		reg = <0>;
		spi-max-frequency = <1000000>;

		/* Polling mode: do NOT set int-gpios */
		/* int-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; */

		/* Optional HW reset (fill with your real pin if used) */
		/* reset-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>; */

		local-mac-address = [00 00 00 00 00 00];
	};
};

&nfct {
	status = "disabled";
};

&uicr {
	nfct-pins-as-gpios;
};
